post_install() {
	echo ":: lintas needs one-time access to /dev/input and /dev/uinput:"
	echo "     sudo usermod -aG input \$USER"
	echo "     echo uinput | sudo tee /etc/modules-load.d/lintas.conf"
	echo "     sudo modprobe uinput"
	echo ":: Then log out and back in so the 'input' group takes effect."
	echo ":: Open TCP 4242 (and UDP 5353 for mDNS discovery) in your firewall if you use one."
}

post_upgrade() {
	post_install
}
